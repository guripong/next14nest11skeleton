{
  "name": "nextnest_skeleton",
  "version": "1.0.0",
  "description": "",
  "author": "KiYoungSo <guripong@hanmail.net>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "doc": "node scripts/generate-docs.js&&node scripts/generate-folder-structure.js",
    "build": "npm run generate:pagelist&& nest build&&next build ./src/nextjs",
    "generate:pagelist": "node scripts/generate-page-list.js",
    "buildDocker": "rm -rf dist &&npm run cleanDocker&& npm run generate:pagelist&& nest build&&next build ./src/nextjs",
    "start:dev": "set NODE_TLS_REJECT_UNAUTHORIZED=0&&set NODE_ENV=development&& nest start --watch",
    "start:prod": "cmd /C \"set NODE_ENV=production&& node dist/nest/src/main.js\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "eslint \"{src}/**/*.ts\" --fix",
    "postinstall": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-ses": "^3.758.0",
